    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18",
    "wrangler": "^4.60.0"
  },
  "dependencies": {
    "badgen": "^3.2.3",
    "hono": "^4.11.5",
    "zod": "^4.0.17"
