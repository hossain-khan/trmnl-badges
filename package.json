{
  "name": "trmnl-badges",
  "private": true,
  "version": "1.0.0",
  "description": "TRMNL Badges - Cloudflare Workers app for generating TRMNL recipe badges",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "deploy": "wrangler deploy --minify",
    "dev": "wrangler dev --minify",
    "test": "vitest",
    "prepare": "husky install"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json}": ["npx prettier --write"]
